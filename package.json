{
  "name": "baraka",
  "version": "2.0.0",
  "description": "BARAKA: Palestinian cafeteria forecasting and food-surplus decision lab",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "check": "node --check public/app.js && node --check public/engine.js && node --check public/today.js && node --check src/worker.js",
    "dev": "wrangler dev",
    "db:local": "wrangler d1 execute baraka-hackathon-db --local --file=schema.sql",
    "db:remote": "wrangler d1 execute baraka-hackathon-db --remote --file=schema.sql",
    "deploy": "wrangler deploy",
    "test:browser": "node scripts/browser-smoke.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "jsdom": "^29.1.1",
    "pdfjs-dist": "^6.5.438",
    "wrangler": "^4.157.0"
  }
}
